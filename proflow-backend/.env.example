DATABASE_URL="mysql://usuario:senha@localhost:3306/proflow"
JWT_SECRET="troque-por-uma-chave-secreta-forte"
PORT=3333

# Em produção, defina o domínio real do painel (separe por vírgula se tiver mais de um).
# Deixe vazio/comentado em desenvolvimento local para aceitar qualquer origem.
# CORS_ORIGIN="https://proflow-admin.vercel.app"

# Deixe "false" (ou omita) pra manter o cadastro público desativado — só você
# cria clientes novos pela área /master. Mude pra "true" só se quiser reabrir
# o /auth/signup público.
PERMITIR_SIGNUP_PUBLICO=false
